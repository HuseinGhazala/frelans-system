generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  jobTitle     String?
  role         Role      @default(EMPLOYEE)
  passwordHash String?
  active       Boolean   @default(true)
  hiredAt      DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      EmployeeProfile?
  authSessions AuthSession[]
  authTokens   AuthToken[]
  workSessions WorkSession[]
  auditLogs    AuditLog[]
}

/// إعدادات الموظف. الحقول الاختيارية الفاضية بتاخد القيمة من الإعدادات العامة.
model EmployeeProfile {
  userId                String  @id
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlySalary         Decimal @db.Decimal(12, 2)
  dailyHours            Decimal @default(8) @db.Decimal(4, 2)
  screenshotIntervalMin Int?
  blurScreenshots       Boolean?
  idleThresholdMin      Int?
  annualLeaveDays       Int     @default(21)
  casualLeaveDays       Int     @default(6)
  trelloMemberId        String?
}

/// جلسة تسجيل دخول على الموقع
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

enum SessionSource {
  AGENT
  WEB
}

enum SessionEndReason {
  MANUAL
  AUTO_IDLE
  DAY_END
}

/// جلسة عمل: من Check-in لحد Check-out
model WorkSession {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    SessionSource
  startedAt DateTime
  endedAt   DateTime?
  endReason SessionEndReason?
  breaks    Break[]

  @@index([userId, startedAt])
}

model Break {
  id        String      @id @default(cuid())
  sessionId String
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?

  @@index([sessionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
