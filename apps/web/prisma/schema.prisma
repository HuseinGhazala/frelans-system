generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  phone               String?
  jobTitle            String?
  role                Role      @default(EMPLOYEE)
  passwordHash        String?
  active              Boolean   @default(true)
  hiredAt             DateTime? @db.Date
  /// وقت موافقة الموظف على المراقبة من برنامج الديسكتوب
  monitoringConsentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile      EmployeeProfile?
  authSessions AuthSession[]
  authTokens   AuthToken[]
  workSessions WorkSession[]
  auditLogs    AuditLog[]
  devices      Device[]
  activity     ActivityMinute[]
  screenshots  Screenshot[]
  leaves       LeaveRequest[]
  payrollItems PayrollItem[]
  alerts       Alert[]
}

/// إعدادات الموظف. الحقول الاختيارية الفاضية بتاخد القيمة من الإعدادات العامة.
model EmployeeProfile {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlySalary         Decimal  @db.Decimal(12, 2)
  dailyHours            Decimal  @default(8) @db.Decimal(4, 2)
  screenshotIntervalMin Int?
  blurScreenshots       Boolean?
  idleThresholdMin      Int?
  annualLeaveDays       Int      @default(21)
  casualLeaveDays       Int      @default(6)
  trelloMemberId        String?
}

/// جلسة تسجيل دخول على الموقع
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

enum SessionSource {
  AGENT
  WEB
}

enum SessionEndReason {
  MANUAL
  AUTO_IDLE
  DAY_END
  /// البرنامج بطّل يبعت (الجهاز اتقفل أو النت فصل لفترة طويلة)
  AGENT_LOST
}

/// جهاز متسجل عليه برنامج الديسكتوب
model Device {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  os         String
  appVersion String?
  tokenHash  String           @unique
  lastSeenAt DateTime?
  /// لو الموظف خامل دلوقتي: من إمتى
  idleSince  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  sessions   WorkSession[]
  events     ProcessedEvent[]

  @@index([userId])
}

/// جلسة عمل: من Check-in لحد Check-out
model WorkSession {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      SessionSource
  deviceId    String?
  device      Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  startedAt   DateTime
  endedAt     DateTime?
  endReason   SessionEndReason?
  breaks      Break[]
  idlePeriods IdlePeriod[]
  activity    ActivityMinute[]
  screenshots Screenshot[]

  @@index([userId, startedAt])
}

model Break {
  id        String      @id @default(cuid())
  sessionId String
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?

  @@index([sessionId])
}

/// أحداث البرنامج اللي اتنفذت — عشان لو الحدث اتبعت مرتين (بعد قطع النت) ما يتنفذش تاني
model ProcessedEvent {
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventId   String
  createdAt DateTime @default(now())

  @@id([deviceId, eventId])
}

/// فترة خمول (مفيش نشاط أكتر من حد الخمول) — ما بتتحسبش ساعات عمل
model IdlePeriod {
  id        String      @id @default(cuid())
  sessionId String
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime

  @@unique([sessionId, startedAt])
}

/// ملخص النشاط لكل دقيقة: أعداد بس، من غير أي محتوى اتكتب
model ActivityMinute {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String
  session      WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  minute       DateTime
  keyboard     Int         @default(0)
  mouse        Int         @default(0)
  app          String?
  title        String?
  domain       String?
  idle         Boolean     @default(false)
  /// كارت Trello اللي الموظف كان شغال عليه
  trelloCardId String?

  @@unique([userId, minute])
  @@index([sessionId])
  @@index([trelloCardId])
}

model TrelloBoard {
  id       String       @id
  name     String
  url      String
  closed   Boolean      @default(false)
  syncedAt DateTime?
  cards    TrelloCard[]
}

model TrelloCard {
  id           String      @id
  boardId      String
  board        TrelloBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  listName     String
  name         String
  url          String
  closed       Boolean     @default(false)
  due          DateTime?
  memberIds    String[]
  lastActivity DateTime?
  syncedAt     DateTime    @default(now())

  @@index([boardId])
}

model TrelloMember {
  id       String @id
  fullName String
  username String
}

/// لقطة شاشة من برنامج الديسكتوب (شاشة واحدة). بتتحذف تلقائي بعد مدة الاحتفاظ.
model Screenshot {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  session    WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  takenAt    DateTime
  /// رقم الشاشة لو عنده أكتر من شاشة
  display    Int         @default(0)
  storageKey String      @unique
  width      Int
  height     Int
  bytes      Int
  blurred    Boolean     @default(false)
  app        String?
  domain     String?
  createdAt  DateTime    @default(now())

  @@unique([userId, takenAt, display])
  @@index([takenAt])
}

enum Productivity {
  PRODUCTIVE
  NEUTRAL
  UNPRODUCTIVE
}

/// تصنيف برنامج أو موقع (الاسم بحروف صغيرة، من غير .exe)
model AppCategory {
  id        String       @id @default(cuid())
  pattern   String       @unique
  category  Productivity
  createdAt DateTime     @default(now())
}

enum LeaveType {
  ANNUAL
  CASUAL
  SICK
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  /// عدد أيام العمل (من غير الإجازة الأسبوعية والرسمية)
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([userId, startDate])
  @@index([status])
}

enum PayrollStatus {
  DRAFT
  APPROVED
}

model PayrollPeriod {
  id           String        @id @default(cuid())
  year         Int
  month        Int
  status       PayrollStatus @default(DRAFT)
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        PayrollItem[]

  @@unique([year, month])
}

/// كشف مرتب موظف لشهر
model PayrollItem {
  id                    String        @id @default(cuid())
  periodId              String
  period                PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlySalary         Decimal       @db.Decimal(12, 2)
  hourlyRate            Decimal       @db.Decimal(12, 4)
  baseSalary            Decimal       @db.Decimal(12, 2)
  requiredHours         Decimal       @db.Decimal(8, 2)
  workedHours           Decimal       @db.Decimal(8, 2)
  paidLeaveHours        Decimal       @db.Decimal(8, 2)
  unpaidLeaveDays       Int           @default(0)
  shortHours            Decimal       @db.Decimal(8, 2)
  deduction             Decimal       @db.Decimal(12, 2)
  surplusHours          Decimal       @db.Decimal(8, 2)
  approvedOvertimeHours Decimal       @default(0) @db.Decimal(8, 2)
  overtimeMultiplier    Decimal       @db.Decimal(4, 2)
  overtimePay           Decimal       @db.Decimal(12, 2)
  /// [{ kind: "BONUS" | "DEDUCTION", amount, reason }]
  adjustments           Json          @default("[]")
  net                   Decimal       @db.Decimal(12, 2)
  updatedAt             DateTime      @updatedAt

  @@unique([periodId, userId])
}

enum AlertType {
  ABSENCE
  MISSING_HOURS
  LONG_IDLE
  LOW_PRODUCTIVITY
  LEAVE_REQUEST
}

/// تنبيه للأدمن
model Alert {
  id        String    @id @default(cuid())
  type      AlertType
  /// الموظف المقصود
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// اليوم (YYYY-MM-DD) بتوقيت الشركة
  day       String
  /// عشان نفس التنبيه ما يتكررش
  dedupeKey String    @unique
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
