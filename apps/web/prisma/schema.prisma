generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  phone               String?
  jobTitle            String?
  role                Role      @default(EMPLOYEE)
  passwordHash        String?
  active              Boolean   @default(true)
  hiredAt             DateTime? @db.Date
  /// وقت موافقة الموظف على المراقبة من برنامج الديسكتوب
  monitoringConsentAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  profile      EmployeeProfile?
  authSessions AuthSession[]
  authTokens   AuthToken[]
  workSessions WorkSession[]
  auditLogs    AuditLog[]
  devices      Device[]
  activity     ActivityMinute[]
  screenshots  Screenshot[]
  leaves       LeaveRequest[]
  payrollItems PayrollItem[]
  alerts       Alert[]

  chatMemberships      ConversationMember[]
  chatMessages         Message[]
  chatCreated          Conversation[]       @relation("ConversationCreator")
  chatMentions         MessageMention[]
  chatAttachments      Attachment[]
  chatEdits            MessageEdit[]
  pushSubscriptions    PushSubscription[]
}

/// نظام عمل الموظف
enum WorkMode {
  /// بالساعات: ساعات يومية مطلوبة + حضور ومراقبة + خصم/إضافي بالساعة
  HOURS
  /// بالتاسكات: من غير حضور ولا مراقبة، بيتقيّم بتسليم كروت Trello
  TASKS
}

/// إعدادات الموظف. الحقول الاختيارية الفاضية بتاخد القيمة من الإعدادات العامة.
model EmployeeProfile {
  userId                String   @id
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workMode              WorkMode @default(HOURS)
  monthlySalary         Decimal  @db.Decimal(12, 2)
  dailyHours            Decimal  @default(8) @db.Decimal(4, 2)
  screenshotIntervalMin Int?
  blurScreenshots       Boolean?
  idleThresholdMin      Int?
  annualLeaveDays       Int      @default(21)
  casualLeaveDays       Int      @default(6)
  trelloMemberId        String?
}

/// جلسة تسجيل دخول على الموقع
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TokenType {
  INVITE
  PASSWORD_RESET
}

model AuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

enum SessionSource {
  AGENT
  WEB
}

enum SessionEndReason {
  MANUAL
  AUTO_IDLE
  DAY_END
  /// البرنامج بطّل يبعت (الجهاز اتقفل أو النت فصل لفترة طويلة)
  AGENT_LOST
}

/// جهاز متسجل عليه برنامج الديسكتوب
model Device {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  os         String
  appVersion String?
  tokenHash  String           @unique
  lastSeenAt DateTime?
  /// لو الموظف خامل دلوقتي: من إمتى
  idleSince  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime         @default(now())
  sessions   WorkSession[]
  events     ProcessedEvent[]

  @@index([userId])
}

/// جلسة عمل: من Check-in لحد Check-out
model WorkSession {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      SessionSource
  deviceId    String?
  device      Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  startedAt   DateTime
  endedAt     DateTime?
  endReason   SessionEndReason?
  breaks      Break[]
  idlePeriods IdlePeriod[]
  activity    ActivityMinute[]
  screenshots Screenshot[]

  @@index([userId, startedAt])
}

model Break {
  id        String      @id @default(cuid())
  sessionId String
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?

  @@index([sessionId])
}

/// أحداث البرنامج اللي اتنفذت — عشان لو الحدث اتبعت مرتين (بعد قطع النت) ما يتنفذش تاني
model ProcessedEvent {
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  eventId   String
  createdAt DateTime @default(now())

  @@id([deviceId, eventId])
}

/// فترة خمول (مفيش نشاط أكتر من حد الخمول) — ما بتتحسبش ساعات عمل
model IdlePeriod {
  id        String      @id @default(cuid())
  sessionId String
  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime

  @@unique([sessionId, startedAt])
}

/// ملخص النشاط لكل دقيقة: أعداد بس، من غير أي محتوى اتكتب
model ActivityMinute {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String
  session      WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  minute       DateTime
  keyboard     Int         @default(0)
  mouse        Int         @default(0)
  app          String?
  title        String?
  domain       String?
  idle         Boolean     @default(false)
  /// كارت Trello اللي الموظف كان شغال عليه
  trelloCardId String?

  @@unique([userId, minute])
  @@index([sessionId])
  @@index([trelloCardId])
}

model TrelloBoard {
  id       String       @id
  name     String
  url      String
  closed   Boolean      @default(false)
  syncedAt DateTime?
  cards    TrelloCard[]
}

model TrelloCard {
  id           String      @id
  boardId      String
  board        TrelloBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  listId       String      @default("")
  listName     String
  name         String
  url          String
  closed       Boolean     @default(false)
  due          DateTime?
  memberIds    String[]
  lastActivity DateTime?
  /// وقت ما الكارت اتنقل لليست "خلصت" (تقريبي: آخر نشاط على الكارت)
  completedAt  DateTime?
  syncedAt     DateTime    @default(now())

  @@index([boardId])
}

model TrelloMember {
  id       String @id
  fullName String
  username String
}

/// لقطة شاشة من برنامج الديسكتوب (شاشة واحدة). بتتحذف تلقائي بعد مدة الاحتفاظ.
model Screenshot {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  session    WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  takenAt    DateTime
  /// رقم الشاشة لو عنده أكتر من شاشة
  display    Int         @default(0)
  storageKey String      @unique
  width      Int
  height     Int
  bytes      Int
  blurred    Boolean     @default(false)
  app        String?
  domain     String?
  createdAt  DateTime    @default(now())

  @@unique([userId, takenAt, display])
  @@index([takenAt])
}

enum Productivity {
  PRODUCTIVE
  NEUTRAL
  UNPRODUCTIVE
}

/// تصنيف برنامج أو موقع (الاسم بحروف صغيرة، من غير .exe)
model AppCategory {
  id        String       @id @default(cuid())
  pattern   String       @unique
  category  Productivity
  createdAt DateTime     @default(now())
}

enum LeaveType {
  ANNUAL
  CASUAL
  SICK
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       LeaveType
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  /// عدد أيام العمل (من غير الإجازة الأسبوعية والرسمية)
  days       Int
  reason     String?
  status     LeaveStatus @default(PENDING)
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([userId, startDate])
  @@index([status])
}

enum PayrollStatus {
  DRAFT
  APPROVED
}

model PayrollPeriod {
  id           String        @id @default(cuid())
  year         Int
  month        Int
  status       PayrollStatus @default(DRAFT)
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  items        PayrollItem[]

  @@unique([year, month])
}

/// كشف مرتب موظف لشهر
model PayrollItem {
  id                    String        @id @default(cuid())
  periodId              String
  period                PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlySalary         Decimal       @db.Decimal(12, 2)
  hourlyRate            Decimal       @db.Decimal(12, 4)
  baseSalary            Decimal       @db.Decimal(12, 2)
  requiredHours         Decimal       @db.Decimal(8, 2)
  workedHours           Decimal       @db.Decimal(8, 2)
  paidLeaveHours        Decimal       @db.Decimal(8, 2)
  unpaidLeaveDays       Int           @default(0)
  shortHours            Decimal       @db.Decimal(8, 2)
  deduction             Decimal       @db.Decimal(12, 2)
  surplusHours          Decimal       @db.Decimal(8, 2)
  approvedOvertimeHours Decimal       @default(0) @db.Decimal(8, 2)
  overtimeMultiplier    Decimal       @db.Decimal(4, 2)
  overtimePay           Decimal       @db.Decimal(12, 2)
  /// [{ kind: "BONUS" | "DEDUCTION", amount, reason }]
  adjustments           Json          @default("[]")
  workMode              WorkMode      @default(HOURS)
  /// لموظفين التاسكات: التاسكات المتأخرة في الشهر (للمراجعة قبل الخصم اليدوي)
  lateTasks             Json          @default("[]")
  net                   Decimal       @db.Decimal(12, 2)
  updatedAt             DateTime      @updatedAt

  @@unique([periodId, userId])
}

enum AlertType {
  ABSENCE
  MISSING_HOURS
  LONG_IDLE
  LOW_PRODUCTIVITY
  LEAVE_REQUEST
  TASK_OVERDUE
}

/// تنبيه للأدمن
model Alert {
  id        String    @id @default(cuid())
  type      AlertType
  /// الموظف المقصود
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// اليوم (YYYY-MM-DD) بتوقيت الشركة
  day       String
  /// عشان نفس التنبيه ما يتكررش
  dedupeKey String    @unique
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ───────────────────────── الشات الداخلي ─────────────────────────

enum ConversationType {
  /// محادثة خاصة بين اتنين
  DIRECT
  /// جروب (أي حد يعمله ويضيف فيه)
  GROUP
  /// القناة العامة: فيها كل المستخدمين النشطين، واحدة بس
  GENERAL
}

enum ConversationRole {
  OWNER
  MEMBER
}

enum AttachmentKind {
  IMAGE
  FILE
  VOICE
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  /// اسم الجروب (الخاص بياخد اسم الطرف التاني)
  name          String?
  /// للخاص: "<id أصغر>:<id أكبر>" عشان المحادثة ما تتكررش. للعامة: "GENERAL"
  uniqueKey     String?          @unique
  createdById   String?
  createdBy     User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  members       ConversationMember[]
  messages      Message[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())
  /// آخر وقت قرا فيه المحادثة — الرسايل بعده = غير مقروءة، وبيتحسب منه "اتقرت"
  lastReadAt     DateTime?
  /// آخر إيميل اتبعتله عن رسايل ماتقرتش في المحادثة دي
  lastEmailedAt  DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String           @default("")
  replyToId      String?
  replyTo        Message?         @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]        @relation("MessageReply")
  editedAt       DateTime?
  /// حذف ناعم: الموظفين بيشوفوا "الرسالة اتمسحت"، والأدمن بيشوف الأصل
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  attachments    Attachment[]
  mentions       MessageMention[]
  edits          MessageEdit[]

  @@index([conversationId, createdAt])
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_body_trgm_idx")
}

/// النسخ القديمة من الرسالة قبل التعديل (للأدمن)
model MessageEdit {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editorId  String
  editor    User     @relation(fields: [editorId], references: [id], onDelete: Cascade)
  /// النص قبل التعديل
  body      String
  createdAt DateTime @default(now())

  @@index([messageId])
}

model MessageMention {
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

/// ملف أو صورة أو ريكورد صوت. بيترفع الأول (messageId فاضي) وبعدين بيتربط بالرسالة لما تتبعت.
model Attachment {
  id          String         @id @default(cuid())
  messageId   String?
  message     Message?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploaderId  String
  uploader    User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  kind        AttachmentKind
  name        String
  mime        String
  bytes       Int
  storageKey  String         @unique
  width       Int?
  height      Int?
  durationSec Int?
  /// الملف اتمسح من التخزين بعد مدة الحفظ (الرسالة بتفضل)
  expiredAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([messageId])
  @@index([createdAt])
}

/// اشتراك إشعارات المتصفح (Web Push)
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
