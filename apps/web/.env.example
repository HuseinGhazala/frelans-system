# رابط قاعدة البيانات PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rased"
# رابط الموقع (بيستخدم في روابط الدعوة واستعادة كلمة المرور)
APP_URL="http://localhost:3000"

# تخزين لقطات الشاشة: local (ملفات على السيرفر) أو s3 (Cloudflare R2 / MinIO / AWS)
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# لو STORAGE_DRIVER=s3:
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="rased"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
