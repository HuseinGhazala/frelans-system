# انسخ الملف ده لـ deploy/.env وعدّل القيم
DOMAIN=rased.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# رابط تحميل برنامج الديسكتوب — لو سبته فاضي بيستخدم آخر نسخة في GitHub Releases
AGENT_DOWNLOAD_URL=
# إشعارات المتصفح للشات — التوليد: npx web-push generate-vapid-keys (سيبهم فاضيين لو مش عاوزها)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
